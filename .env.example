# Server
APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
FORCE_HTTPS=false

# Database (SQLx SQLite URL)
DATABASE_URL=sqlite://data/legal_minds.db

# CORS
# Use "*" only in development. In production, set a comma-separated allowlist.
# Example: "https://app.legalgenie-agent.com,https://admin.legalgenie-agent.com"
CORS_ORIGINS=*

# Auth
# In production: JWT_SECRET must be 32+ chars random and non-default.
JWT_SECRET=change-me-to-a-long-random-secret
# Rotation window: set the previous JWT_SECRET here while rotating; tokens
# signed with it remain valid until it is removed.
# JWT_SECRET_OLD=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=104857600
# Comma-separated extensions (no dots). Default allows note.txt uploads.
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,mp3,wav,txt,json
TEMP_PATH=./storage/temp

# OCR (tesseract)
TESSDATA_DIR=./data/tessdata

# ASR (whisper.cpp via whisper-rs)
WHISPER_MODEL_PATH=./data/models/whisper/ggml-tiny.bin
ASR_LANGUAGE=zh
ASR_THREADS=4

# Translation (bilingual evidence chunks)
# TRANSLATION_PROVIDER=disabled|openai|<any>
# TRANSLATION_BASE_URL=https://api.openai.com/v1
# TRANSLATION_API_KEY=
# Or inject the key from a mounted secret file (recommended for containers):
# TRANSLATION_API_KEY_FILE=/run/secrets/translation_key
# TRANSLATION_MODEL=
# TRANSLATION_TARGET_LANGUAGE=zh-CN
# TRANSLATION_MAX_CONCURRENCY=2
# TRANSLATION_CHUNK_SIZE_LIMIT=2000
