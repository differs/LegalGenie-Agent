# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Database (SQLx SQLite URL)
DATABASE_URL=sqlite://data/legal_minds.db

# CORS
# Use "*" (dev) or a comma-separated allowlist, e.g. "http://localhost:8080,http://127.0.0.1:8080"
CORS_ORIGINS=*

# Auth (placeholder; will be used when auth module is implemented)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=104857600
TEMP_PATH=./storage/temp

# OCR (tesseract)
TESSDATA_DIR=./data/tessdata

# ASR (whisper.cpp via whisper-rs)
WHISPER_MODEL_PATH=./data/models/whisper/ggml-tiny.bin
ASR_LANGUAGE=zh
ASR_THREADS=4
