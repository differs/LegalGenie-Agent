# syntax=docker/dockerfile:1.7

FROM rust:1-bookworm AS builder

WORKDIR /app

# Build deps for native crates (whisper.cpp, fonts, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    pkg-config \
    libssl-dev \
  && rm -rf /var/lib/apt/lists/*

# Copy manifests first for better layer caching.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY server/Cargo.toml server/Cargo.toml
COPY shared/Cargo.toml shared/Cargo.toml

# Dummy sources so `cargo fetch` can run without copying the full repo.
RUN mkdir -p server/src shared/src \
  && printf "fn main(){}\n" > server/src/main.rs \
  && printf "pub fn _dummy(){}\n" > shared/src/lib.rs

RUN cargo fetch

# Now copy full sources and build.
COPY . .
RUN cargo build -p legalminds-server --release

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    poppler-utils \
    tesseract-ocr \
    ffmpeg \
    fontconfig \
    fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/legalminds-server /usr/local/bin/legalminds-server

EXPOSE 8000

# Note: env vars can be provided via docker-compose `.env`.
ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=8000

CMD ["legalminds-server"]

